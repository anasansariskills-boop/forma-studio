{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.js",
      "buildCommand": "npx prisma generate"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/uploads/(.*)", "destination": { "service": "server" } },
    { "source": "/sitemap.xml", "destination": { "service": "server" } },
    { "source": "/robots.txt", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
