# --- FORMA Studio API ---------------------------------------------------
# Copy to server/.env and adjust. Never commit the real file.

# HTTP port for the Express API
PORT=8787

# PostgreSQL connection string.
# Locally this points at the embedded server started by `npm run db:start`.
# In production use your managed Postgres (Neon, Supabase, RDS, Render, …).
DATABASE_URL=postgresql://postgres:forma_local_pw@localhost:55432/forma?schema=public

# Secret used to sign admin JWTs. Must be long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Where uploaded project images live. Swap for S3/Cloudinary by editing
# server/src/lib/storage.js — the rest of the app only sees a public URL.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12
PUBLIC_URL=

# Only read by `npm run seed`. Bootstrap admin account. Quote the password —
# dotenv treats an unquoted # as the start of a comment.
SEED_ADMIN_EMAIL=studio@forma-studio.com
SEED_ADMIN_PASSWORD="ChangeMe!OnceSeeded"
